Yep — LangGraph is exactly where this pattern shines: one shared conversation state (memory) + routing to different Ollama models based on len(messages).

Below is a complete, runnable LangGraph use case:
	•	Uses ChatOllama (local)
	•	Uses MessagesState (built-in message memory state)  ￼
	•	Uses conditional routing based on number of messages
	•	Uses InMemorySaver checkpointer + thread_id so the same conversation persists across turns  ￼

⸻

0) Install

pip install -U langgraph langchain langchain-ollama

Ollama chat model in LangChain is ChatOllama from langchain-ollama.  ￼

⸻

1) Complete LangGraph app: route by message count

Save as app.py and run it.

from __future__ import annotations

from langchain_ollama import ChatOllama
from langchain_core.messages import AIMessage

from langgraph.graph import StateGraph, START, END, MessagesState
from langgraph.checkpoint.memory import InMemorySaver


# ----------------------------
# Models (small + large)
# ----------------------------
small_llm = ChatOllama(model="llama3.2:3b", temperature=0.2)
large_llm = ChatOllama(model="gpt-oss:20b", temperature=0.2)


# ----------------------------
# Routing rule
# ----------------------------
MESSAGE_THRESHOLD = 8  # tune this

def route_by_message_count(state: MessagesState) -> str:
    """
    Decide which node to run next based on number of messages in the thread.
    """
    n = len(state["messages"])
    return "small" if n <= MESSAGE_THRESHOLD else "large"


# ----------------------------
# Nodes
# ----------------------------
def chat_small(state: MessagesState) -> dict:
    # state["messages"] is a list of LangChain Message objects
    ai = small_llm.invoke(state["messages"])
    return {"messages": [ai]}

def chat_large(state: MessagesState) -> dict:
    ai = large_llm.invoke(state["messages"])
    return {"messages": [ai]}


# ----------------------------
# Build graph
# ----------------------------
builder = StateGraph(MessagesState)

builder.add_node("chat_small", chat_small)
builder.add_node("chat_large", chat_large)

# Conditional edge from START -> whichever node the router returns
builder.add_conditional_edges(
    START,
    route_by_message_count,
    {
        "small": "chat_small",
        "large": "chat_large",
    },
)

# Finish after one model response per turn
builder.add_edge("chat_small", END)
builder.add_edge("chat_large", END)

# ----------------------------
# Memory (checkpointer)
# ----------------------------
checkpointer = InMemorySaver()
graph = builder.compile(checkpointer=checkpointer)


# ----------------------------
# “Complete use case” chat loop
# ----------------------------
def main():
    thread_id = "praveen-demo-1"  # one conversation id
    config = {"configurable": {"thread_id": thread_id}}

    print("Type 'exit' to quit.\n")

    while True:
        user_text = input("You: ").strip()
        if user_text.lower() in {"exit", "quit"}:
            break

        # You can pass messages as dicts; LangGraph will deserialize them into Message objects
        # when using MessagesState/add_messages.  [oai_citation:3‡LangChain Docs](https://docs.langchain.com/oss/python/langgraph/graph-api)
        result = graph.invoke(
            {"messages": [{"role": "user", "content": user_text}]},
            config,
        )

        # The latest message should be the assistant
        last = result["messages"][-1]
        print(f"Assistant ({last.response_metadata.get('model', 'unknown')}): {last.content}\n")


if __name__ == "__main__":
    main()

Why this counts as “single agent with memory”
	•	Memory is the graph state (MessagesState)  ￼
	•	Persistence happens via a checkpointer; thread_id identifies the conversation thread  ￼
	•	Each user turn: you call graph.invoke(...) with the same thread_id, and the state (messages) is automatically carried forward.

