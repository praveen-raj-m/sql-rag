from typing_extensions import TypedDict, Annotated
import operator

from langchain_core.messages import AnyMessage, HumanMessage
from langchain_core.prompts import ChatPromptTemplate

from langchain.agents import create_tool_calling_agent, AgentExecutor

from langgraph.graph import StateGraph, START, END
from langgraph.prebuilt import ToolNode
from langgraph.checkpoint.memory import MemorySaver  # simple built-in checkpointer

# -----------------------
# 1) Shared graph state
# -----------------------
class GraphState(TypedDict):
    # Shared “memory”: conversation messages that both agents can read and append to
    messages: Annotated[list[AnyMessage], operator.add]

    # Optional: structured shared memory (facts/artifacts)
    shared_facts: dict

    # Who should act next? ("A", "B", "END")
    next: str


# -----------------------
# 2) Build Agent A and B
# -----------------------
def build_agent(llm, tools, system_text: str):
    prompt = ChatPromptTemplate.from_messages([
        ("system", system_text),
        ("placeholder", "{messages}"),
    ])
    agent = create_tool_calling_agent(llm, tools, prompt)
    return AgentExecutor(agent=agent, tools=tools, verbose=True)


# Example: provide your real tools here
shared_tools = []   # tools both agents can use
tools_a = []        # mostly-A tools
tools_b = []        # mostly-B tools

# IMPORTANT: each agent gets its own tools + shared tools
agent_a_exec = build_agent(
    llm,
    tools=tools_a + shared_tools,
    system_text=(
        "You are Agent A (planner/router). "
        "If a task needs specialist help, set next='B'. "
        "Otherwise solve it and set next='END'. "
        "When you make a decision, include it clearly."
    )
)

agent_b_exec = build_agent(
    llm,
    tools=tools_b + shared_tools,
    system_text=(
        "You are Agent B (specialist/executor). "
        "If you need Agent A to re-plan or ask user a clarifying question, set next='A'. "
        "Otherwise finish and set next='END'. "
        "When you make a decision, include it clearly."
    )
)

# Tool execution nodes (each can be different)
toolnode_a = ToolNode(tools_a + shared_tools)
toolnode_b = ToolNode(tools_b + shared_tools)


# -----------------------
# 3) Node functions
# -----------------------
def run_agent_a(state: GraphState) -> GraphState:
    result = agent_a_exec.invoke({"messages": state["messages"]})
    # AgentExecutor returns an "output" string; wrap it back into messages
    out_msg = result["output"]
    # Decide routing (simple heuristic: look for next='B' / next='END' in text)
    nxt = "B" if "next='B'" in out_msg or 'next="B"' in out_msg else "END"
    return {"messages": [HumanMessage(content=out_msg)], "next": nxt}

def run_agent_b(state: GraphState) -> GraphState:
    result = agent_b_exec.invoke({"messages": state["messages"]})
    out_msg = result["output"]
    nxt = "A" if "next='A'" in out_msg or 'next="A"' in out_msg else "END"
    return {"messages": [HumanMessage(content=out_msg)], "next": nxt}


def route(state: GraphState) -> str:
    return state["next"]


# -----------------------
# 4) Build the graph
# -----------------------
g = StateGraph(GraphState)

g.add_node("agent_a", run_agent_a)
g.add_node("agent_b", run_agent_b)

# If you want tools to run as separate steps, add tool nodes + conditional edges
# (Optional: only if your agents emit tool calls that you want the graph to execute)
g.add_node("tools_a", toolnode_a)
g.add_node("tools_b", toolnode_b)

g.add_edge(START, "agent_a")

# Route after each agent turn
g.add_conditional_edges("agent_a", route, {"B": "agent_b", "END": END})
g.add_conditional_edges("agent_b", route, {"A": "agent_a", "END": END})

# Shared memory persistence (thread-scoped)
checkpointer = MemorySaver()
app = g.compile(checkpointer=checkpointer)

# -----------------------
# 5) Run with a thread_id (shared memory)
# -----------------------
thread_id = "praveen-thread-1"
initial_state = {
    "messages": [HumanMessage(content="User request here...")],
    "shared_facts": {},
    "next": "A",
}
final = app.invoke(initial_state, config={"configurable": {"thread_id": thread_id}})
print(final["messages"][-1].content)